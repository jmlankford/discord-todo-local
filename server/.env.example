# ============================================================
# TaskBot — Environment Variables
# Copy this to .env and fill in your values if running
# outside Docker. When using docker-compose, set these
# directly in docker-compose.yml instead.
# NEVER commit a filled-in .env to git.
# ============================================================

# Discord
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE
GUILD_ID=YOUR_DISCORD_GUILD_ID_HERE
CHANNEL_ID=YOUR_DISCORD_CHANNEL_ID_HERE

# Twilio (core)
TWILIO_SID=YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_FROM=YOUR_TWILIO_PHONE_NUMBER_HERE

# Twilio (API key — for outbound calls)
TWILIO_API_KEY=YOUR_TWILIO_API_KEY_SID_HERE
TWILIO_API_SECRET=YOUR_TWILIO_API_SECRET_HERE

# Bloom & Rose voice routing
FORWARD_NUMBER=YOUR_REAL_FORWARDING_NUMBER_HERE
SMS_SECRET=YOUR_CHOSEN_SECRET_KEY_HERE

# User phones (E.164 format, e.g. +12125551234)
PHONE_JOSH=YOUR_JOSH_PHONE_NUMBER_HERE
PHONE_JB=YOUR_JB_PHONE_NUMBER_HERE
PHONE_ZACH=YOUR_ZACH_PHONE_NUMBER_HERE

# Server
BASE_URL=https://switchboard.thebloomandrose.com
PORT=8080
STATE_FILE=/data/task_state.json
MFA_CODE_FILE=/data/wave_mfa_code.txt
TZ=America/New_York
